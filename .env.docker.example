# ==============================================================================
# ROEYA SCHOOL — Docker Local Development Environment
# ==============================================================================
# Copy this file to .env.docker and fill in your local values.
# This file is used by docker-compose for local development ONLY.
# DO NOT commit .env.docker to version control.
# ==============================================================================

# PostgreSQL
POSTGRES_DB=vision_school
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# API
DATABASE_URL=postgresql://postgres:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/vision_school?schema=public
AUTH_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET_KEY_FOR_JWT_AND_SESSIONS
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
STORAGE_DRIVER=local
