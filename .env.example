# ==============================================================================
# ROEYA SCHOOL — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development

# ── Backend API ──────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=localhost
API_URL=http://localhost:4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Frontend URLs ─────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Local development
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/vision_school?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Docker Postgres (used by docker-compose) ──────────────────────────────────
POSTGRES_DB=vision_school
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here

# ── Authentication & Session Signing ─────────────────────────────────────────
# Minimum 64 random characters — generate with: openssl rand -hex 64
AUTH_SECRET=your_high_entropy_random_secret_key_minimum_64_characters_here
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d

# ── Storage ───────────────────────────────────────────────────────────────────
# Driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_PATH=/media
STORAGE_PRIVATE_PATH=/documents

# S3 / Compatible Cloud Storage (Production only)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=eu-west-3
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=

# ── Google Maps (Optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Email Provider (Optional — for notifications) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@your-school.dz

# ── Platform Defaults ─────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Africa/Algiers
DEFAULT_CURRENCY=DZD
DEFAULT_LOCALE=fr
ACTIVE_ACADEMIC_YEAR=2026/2027
