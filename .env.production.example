# ==============================================================================
# VISION SCHOOL - Production Environment Variables Template
# ==============================================================================
# IMPORTANT: DO NOT commit actual secrets or production credentials to Git.
# Supply these variables via your cloud deployment secret manager (e.g. AWS Secrets Manager, Doppler, Vault).

NODE_ENV=production

# Backend API Configuration
API_PORT=4000
API_HOST=0.0.0.0
API_URL=https://api.vision-school.dz
API_CORS_ORIGINS=https://www.vision-school.dz,https://admin.vision-school.dz

# Frontend Applications
PUBLIC_APP_URL=https://www.vision-school.dz
ADMIN_APP_URL=https://admin.vision-school.dz

# Managed PostgreSQL Database Connection (SSL/TLS Required)
DATABASE_URL=postgresql://vs_prod_app_user:REPLACE_WITH_STRONG_PASSWORD@prod-db.internal:5432/vision_school_prod?sslmode=require
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# High-Entropy Secret Key for JWT & Session Signing (Minimum 32-64 characters)
AUTH_SECRET=REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_KEY_MIN_64_CHARS
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d

# Private & Public Storage (AWS S3 / S3-Compatible Cloud Storage)
STORAGE_DRIVER=s3
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_PATH=/media
STORAGE_PRIVATE_PATH=/documents
STORAGE_S3_BUCKET=vision-school-prod-storage
STORAGE_S3_REGION=eu-west-3
STORAGE_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
STORAGE_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY

# Google Maps API Key (Must be restricted by HTTP referrer to *.vision-school.dz)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_REPLACE_WITH_RESTRICTED_GOOGLE_MAPS_KEY

# Platform Regional & Operational Defaults
DEFAULT_TIMEZONE=Africa/Algiers
DEFAULT_CURRENCY=DZD
DEFAULT_LOCALE=fr
ACTIVE_ACADEMIC_YEAR=2026/2027
